{
  "name": "@ngobe-ai/ngobe",
  "version": "0.5.1",
  "description": "Ngobe: a resource-efficient coding agent CLI for local OpenAI-compatible models (Docker Model Runner, llama.cpp, Ollama, vLLM) with live official-source verification, safe tools and measured self-improvement",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ngobe": "dist/index.js",
    "mugamba": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ngobe-ai/ngobe-cli.git"
  },
  "homepage": "https://github.com/ngobe-ai/ngobe-cli#readme",
  "bugs": {
    "url": "https://github.com/ngobe-ai/ngobe-cli/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "llm",
    "local-llm",
    "docker-model-runner",
    "llama.cpp",
    "ollama",
    "openai-compatible"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:binaries": "bun scripts/build-binaries.ts",
    "release": "bun scripts/release.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.2",
    "ink": "^8.0.0",
    "openai": "^7.39.0",
    "picomatch": "^2.3.1",
    "react": "^19.3.1",
    "unpdf": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/picomatch": "^2.3.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
