{
  "name": "ngobe",
  "version": "0.2.0",
  "description": "Ngobe: a resource-efficient coding agent CLI for local OpenAI-compatible models (Docker Model Runner, llama.cpp, Ollama, vLLM) with live official-source verification, safe tools and measured self-improvement",
  "type": "module",
  "bin": {
    "ngobe": "dist/index.js",
    "mugamba": "dist/index.js"
  },
  "files": [
    "dist",
    "bench",
    "docs",
    "config.example.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ngobe-ai/ngobe-cli.git"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "ink": "^8.0.0",
    "openai": "^7.39.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
